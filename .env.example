# Copy this file to .env (or export the variables in your shell) and adjust local paths.
# The .env file is ignored so credentials and machine-specific paths stay local.
RESLIB_SCRIPT_DIR=../_归档脚本
RESLIB_DISPLAY_DIST=frontend/display/dist/index.html
RESLIB_API_BASE=http://127.0.0.1:8777
RESLIB_SUB_API_BASE=http://127.0.0.1:8781
RESLIB_HOST=127.0.0.1
RESLIB_PORT=8777
RESLIB_SUB_HOST=127.0.0.1
RESLIB_SUB_PORT=8781
RESLIB_TLS_PORT=0
# Set this to the exact origin that hosts the static frontend when it is separate.
RESLIB_CORS_ORIGIN=http://127.0.0.1:8777
# Optional: absolute path to the Python executable used by the start scripts.
RESLIB_PYTHON=
